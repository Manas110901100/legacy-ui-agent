   "type": "account_no",
   "description": "Account number",
   "pattern": "ACC\\d{6}",
   "extract": {
    "label": "Account No"
   }
  },
  "customer": {
   "type": "string",
   "description": "Customer name",
   "pii": "NAME",
   "extract": {
    "label": "Customer"
   }
  },
  "account_type": {
   "type": "string",
   "description": "Savings or Checking",
   "extract": {
    "label": "Type"
   }
  },
  "status": {
   "type": "string",
   "description": "ACTIVE or CLOSED",
   "extract": {
    "label": "Status"
   }
  },
  "balance": {
   "type": "money",
   "description": "Current balance",
   "extract": {
    "label": "Balance"
   }
  },
  "transactions": {
   "type": "table",
   "description": "Rows of the transaction list (date, type, amount, balance after, ...)",
   "extract": {
    "rows_below": "Date Time"
   }
  }
 },
